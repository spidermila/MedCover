# Production Environment Variables
# Copy this file to .env.prod on your server and fill in all values.
# Never commit .env.prod — it is in .gitignore

# Flask environment — must be production
FLASK_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-strong-random-value

# Database — managed Azure SQL service, authenticated passwordlessly via a
# user-assigned managed identity shared by the web and scheduler apps (no
# credentials stored here). Replace <server> with the Azure SQL server name and
# <identity-client-id> with the user-assigned identity's client id, which is
# carried as the URL username. TLS is enforced (Encrypt=yes).
#
# NOTE: on Azure Container Apps the msodbcsql18 driver cannot acquire a token
# from Authentication=ActiveDirectoryMsi (it targets the VM IMDS endpoint, which
# Container Apps does not expose). The app detects this URL form and instead
# fetches the AAD token itself from the Container Apps identity endpoint and
# injects it into pyodbc — see app/db_auth.py. Keep this URL form as-is; the
# app relies on it to trigger the token-injection path.
#
# See the medcover-infra repo (azure-sql-managed-identity.md) for setup details.
DATABASE_URL=mssql+pyodbc://<identity-client-id>@<server>.database.windows.net/MedCover?driver=ODBC+Driver+18+for+SQL+Server&Authentication=ActiveDirectoryMsi&Encrypt=yes

# Outbound email (SMTP) is configured through the web UI setup wizard
# and stored encrypted in the database. No SMTP variables are needed here.

# Developer quick-login — MUST be false in staging/production
DEV_LOGIN_ENABLED=false

# Instance identifier — used in log messages, outbox DB rows, and X-MedCover-Instance SMTP header.
# Set to a short unique name (e.g. "prod") to distinguish this instance from others in email traces.
INSTANCE_ID=prod
