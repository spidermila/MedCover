# Environment Variables — Template
# Copy this file to .env for local development
# Never commit .env — it is in .gitignore

# Flask environment: development | testing | production
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-strong-random-value

# MSSQL connection string
# 'db' is the Docker Compose service name — use this when running inside
# a Docker container (e.g. flask run via docker compose).
DATABASE_URL=mssql+pyodbc://medcover:Dev_Password1!@db:1433/medcover_dev?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=no&TrustServerCertificate=yes
# PRODUCTION (Azure SQL with Managed Identity — no password needed):
# DATABASE_URL=mssql+pyodbc://@server.database.windows.net/MedCover?driver=ODBC+Driver+18+for+SQL+Server&Authentication=ActiveDirectoryMsi&Encrypt=yes

# Backup storage. docker-compose.yml already points web and scheduler at the
# bundled Azurite emulator; set this only when running the app outside compose.
# BACKUP_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# PRODUCTION (Azure Blob Storage with Managed Identity — no key needed):
# BACKUP_CONTAINER_URL=https://<account>.blob.core.windows.net/<container>
# AZURE_CLIENT_ID=<identity-client-id>

# Public address of the app, without a trailing slash. Links in e-mails and
# calendar feeds use it, and requests on any other host are redirected to it.
# Leave empty locally to use whatever host the request came in on; the
# scheduler then uses http://localhost:5000 (set in docker-compose.yml).
# APP_BASE_URL=https://medcover.example.com
APP_BASE_URL=

# Outbound email (SMTP) is configured through the web UI setup wizard
# and stored encrypted in the database. No SMTP variables are needed here.

# Developer quick-login panel (NEVER set to true in staging or production)
# When true, a quick-login panel appears on the login page for each user role.
# Requires running scripts/seed_dev.py to create the dev accounts first.
DEV_LOGIN_ENABLED=false

# Login: "local" (MedCover passwords) or "oidc" (Keycloak, see DEVOPS.md).
# With the MemberBase dev stack (compose profile "memberbase"):
# AUTH_MODE=oidc
# OIDC_CLIENT_SECRET=dev-medcover-client
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# LDAP_URI=ldaps://openldap:1636
# LDAP_CA_CERT=/certs/ca.crt
# LDAP_BASE_DN=dc=example,dc=org
# LDAP_SYNC_PASSWORD=<LDAP_MEDCOVER_SYNC_PASSWORD of the directory>
AUTH_MODE=local

# Instance identifier — used in log messages, outbox DB rows, and X-MedCover-Instance SMTP header.
# Set to "dev" for the dev instance and "prod" for production to distinguish email sources.
INSTANCE_ID=dev
